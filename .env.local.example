# ─── EmailJS Configuration ─────────────────────────────────────────────────
# Copy this file to .env.local and fill in your real EmailJS credentials.
# Get them from: https://www.emailjs.com/docs/introduction/how-does-emailjs-work/
#
# 1. Create a free account at emailjs.com
# 2. Create a new Email Service (Gmail, Outlook, etc.)
# 3. Create an Email Template with the following template variables:
#    {{from_name}}, {{from_email}}, {{subject}}, {{message}}
# 4. Copy the Service ID, Template ID, and Public Key below.

VITE_EMAILJS_SERVICE_ID=your_service_id_here
VITE_EMAILJS_TEMPLATE_ID=your_template_id_here
VITE_EMAILJS_PUBLIC_KEY=your_public_key_here
